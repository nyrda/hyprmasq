# Maintainer: nyrda <nyrda@keymasq.tools>

# Builds the hyprmasq plugin of a release for the Hyprland that is installed. A plugin must be built against the
# exact Hyprland build that loads it, and refuses to load into any other, so rebuild this package after every
# Hyprland update. It picks the commit that targets the installed Hyprland, as hyprpm does: the release's own for
# the Hyprland that the release targets, and otherwise the commit that commit_pins in the release's hyprpm.toml
# names for it.
# The CI of github.com/nyrda/hyprmasq publishes this file from packaging/aur and sets pkgver, sha256sums and pkgrel.

pkgname=hyprmasq-plugin
pkgver=0.2.0
pkgrel=1
pkgdesc='Hyprland plugin of hyprmasq: per-window screenshots and input, built for the installed Hyprland'
arch=(x86_64)
url='https://github.com/nyrda/hyprmasq'
license=(MIT)
depends=(glibc hyprland libei libgcc libglvnd libpng libstdc++ libxcb libxkbcommon)
makedepends=(git jq)
source=("hyprmasq::git+$url.git#tag=v$pkgver")
sha256sums=(SKIP)

prepare() {
  cd hyprmasq
  # The commit that the installed Hyprland was built from, which the plugin compares when it loads.
  local dir header
  for dir in $(pkg-config --cflags-only-I hyprland); do
    if [[ -f ${dir#-I}/src/version.h ]]; then
      header=${dir#-I}/src/version.h
      break
    fi
  done
  if [[ -z $header ]]; then
    echo '==> ERROR: The headers of the installed Hyprland have no src/version.h.' >&2
    return 1
  fi
  local hyprland tag
  hyprland=$(sed -n 's/^#define GIT_COMMIT_HASH *"\([0-9a-f]*\)".*/\1/p' "$header")
  tag=$(sed -n 's/^#define GIT_TAG *"\(.*\)".*/\1/p' "$header")

  local commit
  if [[ -n $hyprland && $hyprland == "$(jq -r .nodes.hyprland.locked.rev flake.lock)" ]]; then
    commit=$(git rev-parse HEAD)
  elif [[ -n $hyprland ]]; then
    commit=$(sed -n "s/^ *\[\"$hyprland\", *\"\([0-9a-f]*\)\"\].*/\1/p" hyprpm.toml)
  fi
  if [[ -z $commit ]]; then
    echo "==> ERROR: hyprmasq $pkgver has no commit for the installed Hyprland, $tag at commit ${hyprland:-unknown}." >&2
    echo "    It supports Hyprland $(<HYPRLAND_VERSION) and the releases in its hyprpm.toml." >&2
    echo '    See https://github.com/nyrda/hyprmasq/blob/main/docs/installation.md#older-hyprland-releases' >&2
    return 1
  fi
  # The MCP server of the release talks only to a plugin with its interface.
  local interface='s/.*INTERFACE = \([0-9]*\);.*/\1/p'
  if [[ $(git show "$commit:src/Commands.hpp" | sed -n "$interface") != $(sed -n "$interface" src/Commands.hpp) ]]; then
    echo "==> ERROR: hyprmasq $pkgver pins commit $commit for the installed Hyprland, $tag, with another interface than" >&2
    echo '    its MCP server. Wait for a release that supports this Hyprland.' >&2
    return 1
  fi
  echo "==> Building hyprmasq $commit for Hyprland $tag"
  git checkout --quiet --detach "$commit"
}

build() {
  cd hyprmasq
  make hyprmasq.so hyprmasq-reaper
}

package() {
  cd hyprmasq
  install -Dm755 hyprmasq.so hyprmasq-reaper -t "$pkgdir/usr/lib/hyprmasq"
  install -Dm644 /dev/stdin "$pkgdir/etc/xdg/hypr/hyprmasq_plugin.lua" <<<'hl.plugin.load("/usr/lib/hyprmasq/hyprmasq.so")'
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
