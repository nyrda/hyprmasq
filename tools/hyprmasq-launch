#!/bin/sh
# hyprmasq-launch: start an application on a hidden workspace and print the address of its first window.
#
#   hyprmasq-launch [--workspace NAME] [--timeout SECONDS] [--] COMMAND [ARG...]
#
# The plugin starts COMMAND through Hyprland and opens the windows of the process and its children silently on the named
# workspace, so neither the focus nor the visible workspace changes, and lists them under a random token; the first one
# is printed. Applications that hand the request to an instance that is already running open their window from a
# process outside the launch; the launch then times out.
#
# Needs hyprctl and jq on PATH, and HYPRLAND_INSTANCE_SIGNATURE of the Hyprland to use.

set -eu

workspace=hyprmasq
timeout=30

usage() {
    if [ $# -gt 0 ]; then
        echo "hyprmasq-launch: $1" >&2
    fi
    echo "usage: hyprmasq-launch [--workspace NAME] [--timeout SECONDS] [--] COMMAND [ARG...]" >&2
    echo "Try 'hyprmasq-launch --help' for options." >&2
    exit 2
}

help() {
    cat <<'EOF'
Start an application on a hidden workspace and print its first window address.

Usage: hyprmasq-launch [OPTIONS] [--] COMMAND [ARG...]
       hyprmasq-launch --help | --version

Options:
  --workspace NAME   Hidden workspace name. Default: hyprmasq.
                     Use only letters, digits, '_', '.' and '-'.
  --timeout SECONDS  Wait for a window for this many seconds. Default: 30.
                     A positive whole number, at most 2147483647.
  --                 End launcher options. Pass command arguments as-is.
  -h, --help         Show this help and exit.
  --version          Show the version and exit.

Needs hyprctl and jq on PATH and HYPRLAND_INSTANCE_SIGNATURE for the compositor.
The command's windows open without changing the user's focus or workspace.
Apps that pass requests to an existing instance may time out.

Exit codes:
  0  A window address, help or version was printed on stdout.
  1  Launch failed, the compositor reply was invalid or no window appeared
     in time.
  2  Invalid arguments. Errors are printed on stderr.
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        -h | --help) help; exit 0 ;;
        --version) echo "hyprmasq-launch @HYPRMASQ_VERSION@"; exit 0 ;;
        --workspace) [ $# -ge 2 ] || usage "--workspace needs a value"; workspace=$2; shift 2 ;;
        --timeout) [ $# -ge 2 ] || usage "--timeout needs a value"; timeout=$2; shift 2 ;;
        --) shift; break ;;
        -*) usage "invalid option '$1'" ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || usage "a command is required"
case $timeout in '' | *[!0-9]*) usage "--timeout must be a positive whole number of seconds, at most 2147483647" ;; esac
# Decimal normalization avoids shell arithmetic treating a leading zero as octal.
timeout=$(printf '%s' "$timeout" | sed 's/^0*//')
if [ -z "$timeout" ] || [ "${#timeout}" -gt 10 ] || [ "$timeout" -gt 2147483647 ]; then
    usage "--timeout must be a positive whole number of seconds, at most 2147483647"
fi
case $workspace in '' | *[!A-Za-z0-9_.-]*)
    usage "the workspace name may only contain letters, digits, '_', '.' and '-'" ;;
esac

# Quotes one argument for /bin/sh, which Hyprland runs the command with. The x keeps command substitution from
# dropping trailing newlines.
quote() {
    quoted=$(printf '%sx' "$1" | sed "s/'/'\\\\''/g")
    printf "'%s'" "${quoted%x}"
}

token=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
line="exec"
for arg; do
    line="$line $(quote "$arg")"
done

# The workspace and the line go in hex, since hyprctl and Hyprland look for words such as --batch, /instances and
# rollinglog anywhere in a request. Hyprland reads a request in pieces of 1023 bytes and waits for another piece after
# one that fills its last piece exactly, so such a request gets a trailing space. hyprctl sends "/" and its arguments
# joined by spaces.
hex() {
    printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n'
}
workspace_hex=$(hex "$workspace")
line_hex=$(hex "$line")
request="/hyprmasq launch $workspace_hex $token $line_hex"
if [ $((${#request} % 1023)) -eq 0 ]; then
    line_hex="$line_hex "
fi
if ! reply=$(hyprctl hyprmasq launch "$workspace_hex" "$token" "$line_hex"); then
    echo "hyprmasq-launch: hyprctl hyprmasq launch failed: $reply" >&2
    exit 1
fi
case $reply in "launched pid "*) ;; *)
    echo "hyprmasq-launch: hyprctl hyprmasq launch failed: $reply" >&2
    exit 1 ;;
esac

deadline=$(($(date +%s) + timeout))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if ! reply=$(hyprctl -j hyprmasq launched); then
        echo "hyprmasq-launch: cannot query launched windows: $reply" >&2
        exit 1
    fi
    if ! address=$(printf '%s\n' "$reply" | jq -rs --arg token "$token" 'if length != 1 or (.[0].windows | type) != "array" then error("expected a windows array") else [.[0].windows[] | select(.token == $token)][0].address // empty end' 2>/dev/null); then
        echo "hyprmasq-launch: invalid JSON from hyprctl hyprmasq launched: $reply" >&2
        exit 1
    fi
    if [ -n "$address" ]; then
        echo "$address"
        exit 0
    fi
    sleep 0.1
done

echo "hyprmasq-launch: no window of the command appeared within ${timeout}s." >&2
echo "Applications that pass the request to an instance that is already running cannot be launched this way." >&2
exit 1
